# --- DATABASE ---
# For local SQLite, leave DATABASE_URL empty or commented out.
# For Production, set this to your Neon PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@hostname/dbname

# --- SECURITY ---
SECRET_KEY=your_super_secret_key_here

# --- FRONTEND URL ---
# For production, set this to your Vercel URL
FRONTEND_URL=http://localhost:5173

# --- EMAIL SETTINGS ---
# To send REAL emails, follow these steps:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail"
# 4. Copy the 16-character code and paste it as SMTP_PASS below
# 5. Fill in your Gmail address as SMTP_USER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# --- VITE (FRONTEND) SETTINGS ---
# For production, Vercel will set this automatically if configured.
VITE_API_URL=http://localhost:4000
