# --- DATABASE ---
# For local SQLite, leave DATABASE_URL empty or commented out.
# For Production, set this to your Neon PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@hostname/dbname

# --- SECURITY ---
SECRET_KEY=your_super_secret_key_here

# --- FRONTEND URL ---
# For production, set this to your Vercel URL
FRONTEND_URL=http://localhost:5173

# --- EMAIL SETTINGS (Optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# --- VITE (FRONTEND) SETTINGS ---
# For production, Vercel will set this automatically if configured.
VITE_API_URL=http://localhost:4000
